# M5 real LLM configuration
PLC_AGENT_MODEL_PROVIDER=openai
PLC_AGENT_MODEL_ID=your-model-id
PLC_AGENT_API_KEY=your-api-key

# Optional for an OpenAI-compatible provider. Leave unset for OpenAI.
PLC_AGENT_API_BASE=

# Optional bounded-agent settings
PLC_AGENT_MAX_ATTEMPTS=3
PLC_AGENT_MODEL_TIMEOUT=120
PLC_AGENT_MAX_TOKENS=8192
PLC_AGENT_TEMPERATURE=0

# Windows can use the repository-built real MatIEC Docker image.
# PLC_MATIEC_BACKEND=docker
# PLC_MATIEC_DOCKER_IMAGE=plc-agent-matiec:m1

# Opt in only when running the real LLM + real OpenPLC integration test.
PLC_AGENT_INTEGRATION=0
PLC_OPENPLC_INTEGRATION=0
